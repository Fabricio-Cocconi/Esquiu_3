{
  "version": 2,
  "functions": {
    "api/index.py": {
      "includeFiles": [
        "modelo_esquiu3.joblib",
        "reservas_esquiu3.csv",
        "reporte_entrenamiento.json",
        "static/**"
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/docs",
      "destination": "/api/index.py"
    },
    {
      "source": "/openapi.json",
      "destination": "/api/index.py"
    },
    {
      "source": "/",
      "destination": "/static/index.html"
    }
  ]
}
